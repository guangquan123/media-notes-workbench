<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>多媒体笔记工作台</title>
<hta:application id="oHTA" applicationname="WorkbenchLauncher" border="thin" caption="yes" maximizebutton="no" minimizebutton="no" showintaskbar="yes" singleinstance="yes" sysmenu="yes" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; color: #152238; background: #eef3f6; }
  body { display: flex; align-items: center; justify-content: center; }
  .shell { width: 640px; min-height: 700px; overflow: hidden; background: #fff; border: 1px solid #d7e0e8; border-radius: 16px; box-shadow: 0 20px 60px rgba(23, 43, 64, .18); }
  .header { padding: 22px 28px; color: #fff; background: #152b45; border-bottom: 3px solid #68d0bf; }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .brand { display: flex; align-items: center; min-width: 0; gap: 12px; }
  .brand-mark { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none; border-radius: 10px; color: #152b45; background: #68d0bf; font-size: 18px; font-weight: 800; }
  .title { overflow: hidden; font-size: 17px; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
  .subtitle { margin-top: 4px; color: #b8c8d8; font-size: 12px; }
  .operation { padding: 7px 11px; border: 1px solid rgba(255,255,255,.25); border-radius: 999px; color: #e6f0f5; font-size: 12px; white-space: nowrap; }
  .content { padding: 25px 28px 20px; }
  .hero { display: flex; align-items: center; gap: 16px; }
  .state-icon { display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; flex: none; border: 1px solid #efd9a5; border-radius: 14px; color: #8a6318; background: #fff7e3; font-size: 17px; font-weight: 700; }
  .state-icon.busy:after { width: 17px; height: 17px; border: 2px solid #d8b96f; border-top-color: #8a6318; border-radius: 50%; content: ""; animation: spin .8s linear infinite; }
  .state-icon.busy { font-size: 0; }
  .state-icon.success { border-color: #9bd8ca; color: #147562; background: #e3f7f1; }
  .state-icon.error { border-color: #efbbb5; color: #a33a35; background: #fff0ee; }
  .hero-copy { min-width: 0; flex: 1; }
  .eyebrow { color: #7c8b98; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .stage { margin-top: 4px; font-size: 21px; font-weight: 680; }
  .detail { max-width: 430px; margin-top: 5px; color: #6c7a89; font-size: 13px; line-height: 1.5; }
  .elapsed-card { min-width: 74px; padding: 9px 10px; border: 1px solid #e1e9ee; border-radius: 9px; text-align: right; background: #f8fafb; }
  .elapsed-card span { display: block; color: #8794a1; font-size: 10px; }
  .elapsed-card strong { display: block; margin-top: 3px; color: #263e52; font-size: 17px; font-weight: 650; }
  .status-chip { display: none; padding: 6px 9px; border-radius: 6px; color: #876116; background: #fff3d7; font-size: 12px; white-space: nowrap; }
  .status-chip.success { color: #16715e; background: #dff5ef; }
  .status-chip.error { color: #a33a35; background: #fde7e5; }
  .progress-wrap { margin-top: 24px; }
  .progress-label { display: flex; justify-content: space-between; margin-bottom: 8px; color: #6c7a89; font-size: 12px; }
  .progress-label strong { color: #20384b; font-weight: 650; }
  .progress-track { height: 8px; overflow: hidden; border-radius: 4px; background: #e8eef2; }
  .progress-bar { width: 0; height: 100%; border-radius: 4px; background: #1aa98c; transition: width .35s ease; }
  .progress-meta { display: flex; justify-content: space-between; margin-top: 7px; color: #8794a1; font-size: 11px; }
  .timeline-title { margin-top: 23px; color: #506273; font-size: 12px; font-weight: 650; }
  .timeline { margin: 12px 0 0; padding: 0; list-style: none; }
  .step { position: relative; display: flex; min-height: 35px; gap: 10px; color: #8996a4; }
  .step:not(:last-child):before { position: absolute; top: 23px; left: 9px; width: 1px; height: 20px; background: #dfe6eb; content: ""; }
  .step-indicator { z-index: 1; display: flex; align-items: center; justify-content: center; width: 21px; height: 21px; flex: none; border: 1px solid #d4dee5; border-radius: 50%; color: #9ba8b2; background: #fff; font-size: 11px; }
  .step-copy { padding-bottom: 8px; font-size: 12px; }
  .step.active { color: #176e69; }
  .step.active .step-indicator { border-color: #1aa98c; color: #fff; background: #1aa98c; }
  .step.done { color: #344d5c; }
  .step.done .step-indicator { border-color: #1aa98c; color: #fff; background: #1aa98c; }
  .step.error { color: #a33a35; }
  .step.error .step-indicator { border-color: #d9665c; color: #fff; background: #d9665c; }
  .spinner { display: inline-block; width: 10px; height: 10px; border: 2px solid rgba(255,255,255,.45); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .diagnostics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 15px; }
  .diagnostic { padding: 9px 10px; border: 1px solid #e1e9ee; border-radius: 8px; background: #f8fafb; }
  .diagnostic-label { color: #8794a1; font-size: 10px; }
  .diagnostic-value { margin-top: 4px; color: #4b6374; font-size: 12px; font-weight: 650; }
  .diagnostic-value.ok { color: #16816d; }
  .diagnostic-value.bad { color: #a33a35; }
  .notice { display: none; margin-top: 15px; padding: 11px 12px; border: 1px solid #efcbc7; border-radius: 8px; color: #8c3d38; background: #fff7f6; font-size: 12px; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 28px; border-top: 1px solid #e8edf0; }
  .elapsed { color: #83909d; font-size: 12px; }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  button { min-height: 32px; padding: 0 12px; border: 1px solid #d6e0e6; border-radius: 6px; color: #415363; background: #fff; font-family: inherit; font-size: 12px; cursor: pointer; }
  button:hover { background: #f3f7f8; }
  button.primary { border-color: #168d78; color: #fff; background: #168d78; }
  button.primary:hover { background: #117563; }
  button[disabled] { cursor: default; opacity: .55; }
</style>
</head>
<body>
  <main class="shell">
    <header class="header">
      <div class="header-row">
        <div class="brand"><div class="brand-mark">M</div><div><div class="title">多媒体笔记工作台</div><div class="subtitle" id="subtitle">正在准备运行环境</div></div></div>
        <div class="operation" id="operation">启动服务</div>
      </div>
    </header>
    <section class="content">
      <div class="hero"><div class="state-icon busy" id="stateIcon">M</div><div class="hero-copy"><div class="eyebrow" id="eyebrow">LOCAL SERVICE CONTROL</div><div class="stage" id="stage">准备中</div><div class="detail" id="detail">正在读取本地配置并检查服务状态</div></div><div class="elapsed-card"><span>已用时</span><strong id="elapsed">0s</strong></div></div>
      <div class="progress-wrap"><div class="progress-label"><span>执行进度</span><strong id="progressText">0%</strong></div><div class="progress-track"><div class="progress-bar" id="progressBar"></div></div></div>
      <div class="timeline-title">执行步骤</div>
      <ol class="timeline" id="timeline"></ol>
      <div class="diagnostics"><div class="diagnostic"><div class="diagnostic-label">后端服务</div><div class="diagnostic-value" id="backendState">待检查</div></div><div class="diagnostic"><div class="diagnostic-label">前端页面</div><div class="diagnostic-value" id="frontendState">待检查</div></div><div class="diagnostic"><div class="diagnostic-label">主进程</div><div class="diagnostic-value" id="pidState">待检查</div></div></div>
      <div class="notice" id="notice"></div>
    </section>
    <footer class="footer"><div class="elapsed" id="footerMessage">请稍候，正在执行操作</div><div class="actions"><button id="openButton" class="primary" style="display:none" onclick="openWorkbench()">打开工作台</button><button id="logButton" style="display:none" onclick="openLog()">查看日志</button><button id="retryButton" class="primary" style="display:none" onclick="retry()">重新尝试</button><button id="closeButton" onclick="closeLauncher()">后台运行</button></div></footer>
  </main>
<script>
  var action = "start";
  var shell = null;
  var fso = null;
  var root = ".";
  var config = { serverHost: "127.0.0.1", serverPort: "3000", clientHost: "127.0.0.1", clientPort: "8081", basePath: "" };
  var steps = [];
  var currentStep = -1;
  var failed = false;
  var finished = false;
  var pollTimer = null;
  var closeTimer = null;
  var startedAt = new Date().getTime();
  var deadline = 120000;
  var restartObservedDown = false;
  var operationNames = { start: "启动服务", stop: "停止服务", restart: "重启服务" };
  var scriptNames = { start: "launch-windows.js", stop: "stop.js", restart: "restart-windows.js" };

  try { shell = new ActiveXObject("WScript.Shell"); } catch (e) {}
  try { fso = new ActiveXObject("Scripting.FileSystemObject"); root = fso.GetAbsolutePathName("."); } catch (e) {}
  try { var match = (oHTA.commandLine || "").match(/\b(start|restart|stop)\b/i); if (match) action = match[1].toLowerCase(); } catch (e) {}

  function readEnvFile(name) {
    var values = {};
    if (!fso) return values;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, name), 1, false, 0);
      while (!file.AtEndOfStream) {
        var line = file.ReadLine().replace(/^\s+|\s+$/g, "");
        if (!line || line.charAt(0) === "#") continue;
        var index = line.indexOf("=");
        if (index < 1) continue;
        var key = line.substring(0, index).replace(/^export\s+/, "").replace(/^\s+|\s+$/g, "");
        var value = line.substring(index + 1).replace(/^\s+|\s+$/g, "").replace(/^['"]|['"]$/g, "");
        values[key] = value;
      }
      file.Close();
    } catch (e) {}
    return values;
  }

  function loadConfig() {
    var values = readEnvFile(".env");
    var local = readEnvFile(".env.local");
    var key;
    for (key in local) values[key] = local[key];
    config.serverHost = values.SERVER_HOST || config.serverHost;
    config.serverPort = values.SERVER_PORT || config.serverPort;
    config.clientHost = values.CLIENT_DEV_HOST || config.clientHost;
    config.clientPort = values.CLIENT_DEV_PORT || config.clientPort;
    config.basePath = values.CLIENT_BASE_PATH || "";
    if (config.basePath === "/") config.basePath = "";
    if (config.basePath.charAt(0) !== "/" && config.basePath) config.basePath = "/" + config.basePath;
    config.basePath = config.basePath.replace(/\/+$/, "");
  }

  function url(host, port, path) { return "http://" + host + ":" + port + (path || "/"); }
  function serverUrl() { return url(config.serverHost, config.serverPort, "/"); }
  function workbenchUrl() { return url(config.clientHost, config.clientPort, config.basePath + "/"); }

  function httpStatus(target) {
    var request = null;
    try { request = new ActiveXObject("WinHttp.WinHttpRequest.5.1"); } catch (e) { try { request = new ActiveXObject("Microsoft.XMLHTTP"); } catch (e2) {} }
    if (!request) return 0;
    try { request.SetTimeouts(500, 800, 800, 1200); } catch (e) {}
    try { request.Open("GET", target, false); request.Send(); return request.Status || 0; } catch (e) { return 0; }
  }

  function backendUp() { var status = httpStatus(serverUrl()); return status > 0 && status < 500; }
  function frontendReady() { var status = httpStatus(workbenchUrl()); return status >= 200 && status < 400; }
  function readPid() {
    if (!fso) return 0;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\dev-local.pid"), 1, false, 0);
      var value = parseInt(file.ReadAll().replace(/^\s+|\s+$/g, ""), 10);
      file.Close();
      return isNaN(value) ? 0 : value;
    } catch (e) { return 0; }
  }
  function launcherActive() {
    var pid = readPid();
    if (!pid) return false;
    try {
      var locator = new ActiveXObject("WbemScripting.SWbemLocator");
      var service = locator.ConnectServer(".", "root\\cimv2");
      var process = service.Get("Win32_Process.Handle='" + pid + "'");
      var commandLine = String(process.CommandLine || "").toLowerCase().replace(/\\/g, "/");
      return commandLine.indexOf("scripts/dev-windows.js") >= 0;
    } catch (e) { return false; }
  }

  function setText(id, value) { document.getElementById(id).innerText = value; }
  function setStatus(label, kind) { var chip = document.getElementById("statusChip"); chip.innerText = label; chip.className = "status-chip" + (kind ? " " + kind : ""); }
  function setDiagnostic(id, label, good) { var element = document.getElementById(id); element.innerText = label; element.className = "diagnostic-value" + (good === true ? " ok" : good === false ? " bad" : ""); }
  function updateDiagnostics(backend, frontend, active) { var stopping = action === "stop"; setDiagnostic("backendState", backend ? "已响应" : stopping ? "已停止" : "未响应", stopping ? !backend : backend); setDiagnostic("frontendState", frontend ? "可访问" : stopping ? "已停止" : "未访问", stopping ? !frontend : frontend); setDiagnostic("pidState", active ? "运行中" : "已释放", stopping ? !active : active); }
  function setProgress(value) { var percent = Math.max(0, Math.min(100, value)); document.getElementById("progressBar").style.width = percent + "%"; setText("progressText", Math.round(percent) + "%"); }
  function renderSteps() {
    var html = "";
    var i;
    for (i = 0; i < steps.length; i++) {
      var cls = "step"; var icon = "";
      if (failed && i === currentStep) { cls += " error"; icon = "!"; }
      else if (i < currentStep || (finished && i === currentStep)) { cls += " done"; icon = "&#10003;"; }
      else if (i === currentStep) { cls += " active"; icon = '<span class="spinner"></span>'; }
      else { icon = String(i + 1); }
      html += '<li class="' + cls + '"><span class="step-indicator">' + icon + '</span><span class="step-copy">' + steps[i] + '</span></li>';
    }
    document.getElementById("timeline").innerHTML = html;
  }
  function moveTo(index, stage, detail) { currentStep = index; setText("stage", stage); setText("detail", detail); setProgress(Math.round((index / Math.max(1, steps.length - 1)) * 100)); renderSteps(); }
  function setFailure(stage, detail) {
    failed = true; setText("stage", stage); setText("detail", "请查看下方诊断状态，必要时打开日志重试。"); setText("eyebrow", "ACTION REQUIRED"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon error"; icon.innerText = "!"; setText("footerMessage", "服务没有按预期完成"); document.getElementById("notice").style.display = "block"; document.getElementById("notice").innerText = detail.indexOf("\n") >= 0 ? detail.substring(0, detail.indexOf("\n")) : detail; document.getElementById("logButton").style.display = "inline-block"; document.getElementById("retryButton").style.display = "inline-block"; document.getElementById("closeButton").innerText = "关闭"; renderSteps();
  }
  function readLogTail() {
    if (!fso) return "";
    try { var file = fso.OpenTextFile(fso.BuildPath(root, "logs\\dev.std.log"), 1, false, 0); var text = file.ReadAll(); file.Close(); return text.length > 5000 ? text.substring(text.length - 5000) : text; } catch (e) { return ""; }
  }
  function openLog() { if (shell) { try { shell.Run("notepad.exe " + quote(fso.BuildPath(root, "logs\\dev.std.log")), 1, false); } catch (e) {} } }
  function quote(value) { return '"' + String(value).replace(/"/g, '""') + '"'; }
  function openWorkbench() { if (shell) { try { shell.Run(workbenchUrl(), 1, false); } catch (e) {} } }
  function closeLauncher() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); window.close(); }
  function invokeScript() { if (!shell) { setFailure("无法执行操作", "无法创建 Windows 脚本宿主，请检查系统组件是否可用。"); return false; } try { shell.CurrentDirectory = root; shell.Run("node.exe " + quote(fso.BuildPath(root, "scripts\\" + scriptNames[action])), 0, false); return true; } catch (e) { setFailure("无法执行操作", "无法启动 Node.js。请确认 Node.js 已安装，并点击“打开日志”查看详情。\n" + e.message); return false; } }
  function complete(message, shouldOpen) { finished = true; currentStep = steps.length - 1; setProgress(100); setText("stage", "已完成"); setText("detail", message); setText("eyebrow", "OPERATION COMPLETE"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon success"; icon.innerText = "OK"; setText("footerMessage", message); renderSteps(); if (shouldOpen) { openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; } document.getElementById("closeButton").innerText = "关闭"; var seconds = action === "stop" ? 2 : 3; closeTimer = window.setTimeout(closeLauncher, seconds * 1000); }
  function tickElapsed() { if (!finished && !failed) { setText("elapsed", Math.floor((new Date().getTime() - startedAt) / 1000) + "s"); window.setTimeout(tickElapsed, 1000); } }
  function poll() {
    if (finished || failed) return;
    var elapsed = new Date().getTime() - startedAt;
    if (elapsed > deadline) { setFailure("等待超时", "服务在 120 秒内没有达到预期状态。\n\n" + readLogTail()); return; }
    var backend = backendUp(); var frontend = frontendReady(); var pid = launcherActive(); updateDiagnostics(backend, frontend, pid);
    if (action === "stop") {
      if (backend || frontend || pid) moveTo(1, "正在确认进程退出", "正在等待后台进程和端口完全释放");
      else complete("服务已停止，端口已释放", false);
    } else if (action === "restart") {
      if (!pid && !backend && !frontend) restartObservedDown = true;
      if (restartObservedDown && currentStep < 2) moveTo(2, "旧服务已停止", "正在等待新服务接管端口");
      else if (restartObservedDown && backend && currentStep < 4) moveTo(4, "后端已就绪", "正在等待前端页面响应");
      else if (restartObservedDown && frontend && currentStep < 6) moveTo(6, "页面已就绪", "正在打开工作台");
      if (restartObservedDown && frontend) complete("重启完成，正在打开工作台", true);
    } else {
      if (pid && currentStep < 1) moveTo(1, "服务已启动", "正在等待后端开始监听");
      if (backend && currentStep < 3) moveTo(3, "后端已就绪", "正在等待前端页面响应");
      if (frontend) complete("启动完成，正在打开工作台", true);
    }
    pollTimer = window.setTimeout(poll, 700);
  }
  function retry() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); failed = false; finished = false; startedAt = new Date().getTime(); document.getElementById("notice").style.display = "none"; document.getElementById("logButton").style.display = "none"; document.getElementById("retryButton").style.display = "none"; document.getElementById("openButton").style.display = "none"; document.getElementById("closeButton").innerText = action === "stop" ? "关闭" : "后台运行"; begin(); }
  function begin() { loadConfig(); restartObservedDown = false; steps = action === "stop" ? ["检查运行状态", "停止服务", "确认进程退出", "确认端口释放"] : action === "restart" ? ["检查旧服务", "停止旧服务", "确认旧服务已停止", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"] : ["检查环境", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"]; currentStep = 0; setText("operation", operationNames[action]); setText("subtitle", action === "stop" ? "正在安全停止本地服务" : action === "restart" ? "正在平滑重启本地服务" : "正在启动本地开发服务"); setText("eyebrow", "LOCAL SERVICE CONTROL"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon busy"; icon.innerText = "M"; setText("stage", steps[0]); setText("detail", "正在检查本地服务状态"); setText("footerMessage", "请稍候，正在执行操作"); setProgress(8); renderSteps(); if (action !== "stop" && !invokeScript()) return; if (action === "stop") invokeScript(); poll(); }
  document.getElementById("openButton").style.display = "none";
  window.resizeTo(680, 760);
  tickElapsed();
  begin();
</script>
</body>
</html>
