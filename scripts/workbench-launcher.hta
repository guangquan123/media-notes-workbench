<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>多媒体笔记工作台</title>
<hta:application id="oHTA" applicationname="WorkbenchLauncher" border="thin" caption="yes" commandline="yes" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; font-family: "Segoe UI", "Microsoft YaHei", -apple-system, sans-serif; background: #f6f7fb; color: #1a1a1a; }
  body { display: flex; align-items: center; justify-content: center; height: 100vh; }
  .card { width: 420px; border-radius: 20px; background: #fff; box-shadow: 0 24px 70px rgba(20,30,70,0.16); overflow: hidden; }
  .head { padding: 24px 26px 20px; background: linear-gradient(135deg, #4f6bff 0%, #7a5cff 100%); color: #fff; }
  .head .row { display: flex; align-items: center; gap: 12px; }
  .logo { width: 44px; height: 44px; border-radius: 13px; background: rgba(255,255,255,0.18); display: flex; align-items: center; justify-content: center; font-size: 22px; backdrop-filter: blur(6px); }
  .title { font-size: 17px; font-weight: 600; letter-spacing: 0.2px; }
  .subtitle { font-size: 12.5px; opacity: 0.85; margin-top: 3px; }
  .body { padding: 22px 26px 20px; }
  .steps { list-style: none; margin: 0 0 18px; padding: 0; }
  .step { display: flex; align-items: center; gap: 12px; padding: 9px 0; font-size: 14px; color: #6b7280; }
  .step .icon { width: 22px; height: 22px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; font-size: 12px; background: #e5e7eb; color: #9ca3af; }
  .step.active { color: #4f6bff; }
  .step.active .icon { background: #4f6bff; color: #fff; }
  .step.done { color: #16a34a; }
  .step.done .icon { background: #16a34a; color: #fff; }
  .spinner { display: inline-block; width: 13px; height: 13px; border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .progress { height: 6px; border-radius: 3px; background: #eef0f5; overflow: hidden; }
  .progress .bar { height: 100%; width: 0%; border-radius: 3px; background: linear-gradient(90deg, #4f6bff, #7a5cff); transition: width 0.5s ease; }
  .footer { padding: 16px 26px; border-top: 1px solid #f0f1f5; display: flex; align-items: center; justify-content: space-between; }
  .msg { font-size: 13px; color: #6b7280; }
  .msg.ok { color: #16a34a; }
  .msg.err { color: #dc2626; }
  .actions { display: flex; gap: 8px; }
  .btn { border: none; border-radius: 10px; padding: 8px 16px; font-size: 13px; cursor: pointer; background: #111315; color: #fff; font-weight: 500; }
  .btn:hover { background: #000; }
  .btn.ghost { background: #f1f2f6; color: #374151; }
  .btn.ghost:hover { background: #e5e7eb; }
</style>
</head>
<body>
  <div class="card">
    <div class="head">
      <div class="row">
        <div class="logo">&#128172;</div>
        <div><div class="title">多媒体笔记工作台</div><div class="subtitle" id="subtitle">正在准备…</div></div>
      </div>
    </div>
    <div class="body">
      <ul class="steps" id="steps"></ul>
      <div class="progress"><div class="bar" id="bar"></div></div>
    </div>
    <div class="footer">
      <div class="msg" id="msg"></div>
      <div class="actions">
        <button class="btn ghost" id="logBtn" style="display:none" onclick="openLog()">打开日志</button>
        <button class="btn" id="closeBtn" onclick="window.close()">关闭</button>
      </div>
    </div>
  </div>
<script>
  var action = "restart";
  try { var m = (oHTA.commandLine || "").match(/\b(start|restart|stop)\b/i); if (m) action = m[1].toLowerCase(); } catch (e) {}

  var shell = null;
  try { shell = new ActiveXObject("WScript.Shell"); } catch (e) {}

  var steps = (action === "stop") ? ["停止服务"] : ["停止旧服务", "启动后端", "启动前端", "启动完成"];
  var stepIndex = -1;

  function renderSteps() {
    var list = document.getElementById("steps");
    var html = "";
    for (var i = 0; i < steps.length; i++) {
      var cls = "step"; var icon = "";
      if (i < stepIndex) { cls += " done"; icon = "&#10003;"; }
      else if (i === stepIndex) { cls += " active"; icon = '<span class="spinner"></span>'; }
      else { icon = "&#9679;"; }
      html += '<li class="' + cls + '"><span class="icon">' + icon + '</span>' + steps[i] + '</li>';
    }
    list.innerHTML = html;
    var pct = stepIndex < 0 ? 0 : Math.round(((stepIndex + 1) / steps.length) * 100);
    document.getElementById("bar").style.width = pct + "%";
  }

  function setMsg(text, kind) {
    var el = document.getElementById("msg");
    el.textContent = text;
    el.className = "msg" + (kind === "ok" ? " ok" : kind === "err" ? " err" : "");
  }

  function openLog() { if (shell) { try { shell.Run("notepad.exe logs\dev.std.log", 1, false); } catch (e) {} } }

  function finish(ok, text) {
    stepIndex = steps.length - 1;
    renderSteps();
    document.getElementById("subtitle").textContent = ok ? "启动完成" : "启动未完成";
    setMsg(text, ok ? "ok" : "err");
    if (!ok) { document.getElementById("logBtn").style.display = "inline-block"; }
    var n = 5;
    document.getElementById("closeBtn").textContent = "立即关闭";
    var t = setInterval(function () { n -= 1; if (n <= 0) { window.close(); return; } document.getElementById("closeBtn").textContent = n + " 秒后自动关闭"; }, 1000);
  }

  (function start() {
    window.resizeTo(440, 420);
    var scriptFile = action === "start" ? "launch-windows.js" : action === "restart" ? "restart-windows.js" : "stop.js";
    var ok = false;
    if (shell) { try { shell.Run("node.exe scripts\\" + scriptFile, 0, false); ok = true; } catch (e) { ok = false; } }
    if (!ok) {
      document.getElementById("subtitle").textContent = "启动失败";
      setMsg("无法执行启动命令，请检查 Node.js 是否安装", "err");
      document.getElementById("logBtn").style.display = "inline-block";
      return;
    }
    document.getElementById("subtitle").textContent = action === "stop" ? "正在停止服务" : "正在启动服务";
    setMsg("正在后台启动，请稍候…");
    renderSteps();

    if (action === "stop") {
      stepIndex = 0; renderSteps();
      setTimeout(function () { finish(true, "已停止服务"); }, 2500);
      return;
    }
    setTimeout(function () { stepIndex = 0; renderSteps(); }, 1000);
    setTimeout(function () { stepIndex = 1; renderSteps(); }, 6000);
    setTimeout(function () { stepIndex = 2; renderSteps(); }, 14000);
    setTimeout(function () { finish(true, "已启动完成，可以开始使用了"); }, 22000);
  })();
</script>
</body>
</html>
