<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=Edge" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>多媒体笔记工作台</title>
<hta:application id="oHTA" applicationname="WorkbenchLauncher" border="thin" caption="yes" maximizebutton="no" minimizebutton="no" showintaskbar="yes" singleinstance="no" sysmenu="yes" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; color: #0f2743; background: #f3f8fe; }
  body { min-width: 0; background: #f3f8fe; }
  .shell { width: 100%; min-height: 100%; overflow: hidden; background: #f3f8fe; }
  .header { position: relative; height: 148px; overflow: hidden; padding: 25px 30px 20px; color: #102a48; background: #e8f3ff; }
  .header:before, .header:after { position: absolute; border: 1px solid rgba(39, 120, 246, .14); border-radius: 50%; content: ""; pointer-events: none; }
  .header:before { top: -115px; right: -18px; width: 255px; height: 255px; box-shadow: 0 0 0 34px rgba(39, 120, 246, .045), 0 0 0 70px rgba(39, 120, 246, .025); }
  .header:after { top: -80px; right: 18px; width: 190px; height: 190px; background: rgba(84, 200, 232, .12); border-color: rgba(84, 200, 232, .11); }
  .header-row, .hero { position: relative; z-index: 1; display: flex; align-items: center; }
  .header-row { justify-content: space-between; gap: 20px; }
  .brand { display: flex; align-items: center; min-width: 0; gap: 12px; }
  .brand-mark { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; flex: none; border-radius: 11px; color: #fff; background: #2778f6; box-shadow: 0 8px 18px rgba(39, 120, 246, .22); font-size: 16px; font-weight: 800; letter-spacing: -.04em; }
  .title { overflow: hidden; color: #102a48; font-size: 16px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
  .subtitle { margin-top: 4px; color: #6e87a3; font-size: 11px; }
  .header-meta { min-width: 180px; margin-right: 154px; color: #2778f6; font-size: 10px; letter-spacing: .08em; line-height: 1.8; text-align: left; text-transform: uppercase; }
  .header-meta span { color: #627e9d; letter-spacing: .02em; }
  .operation { display: none; }
  .hero { align-items: flex-end; margin-top: 21px; gap: 26px; }
  .state-icon { display: none; }
  .hero-copy { min-width: 0; }
  .eyebrow { color: #2778f6; font-size: 10px; font-weight: 650; letter-spacing: .13em; text-transform: uppercase; }
  .stage { margin-top: 2px; color: #102a48; font-size: 24px; font-weight: 700; letter-spacing: -.03em; line-height: 1.15; }
  .detail { max-width: 390px; margin: 0 0 2px; color: #6e87a3; font-size: 13px; line-height: 1.45; }
  .hero-meta { display: none; }
  .elapsed-card { position: absolute; right: 0; bottom: -1px; min-width: 91px; padding: 8px 11px; border: 1px solid #c6dcf2; border-radius: 11px; text-align: right; background: rgba(255,255,255,.56); }
  .elapsed-card span { display: block; color: #6e87a3; font-size: 10px; }
  .elapsed-card strong { display: block; margin-top: 1px; color: #102a48; font-size: 17px; font-weight: 700; }
  .workspace { min-height: 0; padding: 21px 24px 24px; background-color: #f3f8fe; background-image: linear-gradient(rgba(120, 167, 211, .12) 1px, transparent 1px), linear-gradient(90deg, rgba(120, 167, 211, .12) 1px, transparent 1px); background-position: -1px -1px; background-size: 16px 16px; }
  .overview-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(220px, .92fr); gap: 22px; }
  .panel { border: 1px solid #cfe0f1; border-radius: 13px; background: rgba(255,255,255,.94); box-shadow: 0 8px 18px rgba(49, 103, 158, .045); }
  .status-panel { min-height: 263px; padding: 21px 24px 16px; }
  .panel-kicker { color: #6e87a3; font-size: 11px; }
  .status-heading { display: flex; align-items: center; gap: 10px; margin-top: 18px; }
  .status-heading strong { color: #102a48; font-size: 20px; font-weight: 700; }
  .status-dot { width: 11px; height: 11px; flex: none; border-radius: 50%; background: #2778f6; box-shadow: 0 0 0 5px rgba(39, 120, 246, .12); animation: state-breathe 1.8s ease-in-out infinite; }
  .status-dot.success { background: #13b8a6; box-shadow: 0 0 0 5px rgba(19, 184, 166, .12); animation: success-pop .28s ease-out both; }
  .status-dot.error { background: #e4515b; box-shadow: 0 0 0 5px rgba(228, 81, 91, .12); animation: none; }
  .status-copy { min-height: 20px; margin-top: 8px; color: #6e87a3; font-size: 12px; }
  .field-label { margin-top: 15px; color: #6e87a3; font-size: 11px; }
  .address { overflow: hidden; margin-top: 4px; color: #0f4676; font-size: 12px; white-space: nowrap; text-overflow: ellipsis; }
  .progress-track { height: 7px; margin-top: 19px; overflow: hidden; border-radius: 999px; background: #e4edf6; }
  .progress-bar { width: 0; height: 100%; border-radius: 999px; background: #2778f6; box-shadow: 7px 0 16px rgba(39, 120, 246, .28); transition: width .35s ease; }
  .progress-bar.is-success { background: #13b8a6; box-shadow: 7px 0 16px rgba(19, 184, 166, .25); }
  .progress-bar.is-error { background: #e4515b; box-shadow: 7px 0 16px rgba(228, 81, 91, .25); }
  .card-progress-meta { display: flex; align-items: baseline; justify-content: space-between; margin-top: 10px; color: #6e87a3; font-size: 11px; }
  .card-progress-meta strong { color: #2778f6; font-size: 18px; }
  .card-progress-meta strong.success { color: #13b8a6; }
  .card-progress-meta strong.error { color: #e4515b; }
  .status-panel-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 7px; color: #6e87a3; font-size: 11px; }
  .status-panel-footer .next-step { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .progress-panel { min-height: 263px; padding: 21px 24px 16px; }
  .progress-panel-title { display: flex; align-items: baseline; justify-content: space-between; color: #102a48; }
  .progress-panel-title strong { font-size: 16px; }
  .progress-panel-title span { color: #6e87a3; font-size: 11px; }
  .timeline { position: relative; margin: 17px 0 0; padding: 0; list-style: none; }
  .timeline:before { position: absolute; top: 12px; bottom: 12px; left: 7px; width: 1px; background: #dbe8f3; content: ""; }
  .step { position: relative; display: flex; align-items: center; min-height: 29px; gap: 10px; color: #9bb0c4; font-size: 11px; }
  .step-indicator { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 15px; height: 15px; flex: none; border: 2px solid #d5e3ef; border-radius: 50%; color: transparent; background: #fff; font-size: 9px; }
  .step-copy { min-width: 0; line-height: 1.3; }
  .step.active { color: #2778f6; font-weight: 650; }
  .step.active .step-indicator { border-color: #2778f6; box-shadow: 0 0 0 3px rgba(39, 120, 246, .12); animation: step-pulse 1.8s ease-in-out infinite; }
  .step.done { color: #123c62; font-weight: 650; }
  .step.done .step-indicator { border-color: #13b8a6; color: #fff; background: #13b8a6; animation: step-complete .28s ease-out both; }
  .step.error { color: #e4515b; font-weight: 650; }
  .step.error .step-indicator { border-color: #e4515b; background: #e4515b; }
  .remaining { margin-top: 5px; color: #6e87a3; font-size: 11px; }
  .service-section { margin-top: 20px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; }
  .section-heading strong { color: #102a48; font-size: 15px; }
  .section-heading span { color: #2778f6; font-size: 10px; }
  .service-panel { padding: 14px 24px 10px; }
  .service-row { display: grid; grid-template-columns: 1.05fr .8fr 1.65fr; align-items: center; min-height: 39px; border-top: 1px solid #dbe8f3; color: #6e87a3; font-size: 11px; }
  .service-row:first-child { min-height: 25px; border-top: 0; color: #7790aa; }
  .service-row > span:first-child { color: #0f2743; }
  .service-row:first-child > span:first-child { color: #7790aa; }
  .diagnostic-value { color: #6e87a3; font-weight: 600; }
  .diagnostic-value.ok { color: #0d9f8e; }
  .diagnostic-value.bad { color: #e4515b; }
  .diagnostic-detail { overflow: hidden; color: #8aa1b7; white-space: nowrap; text-overflow: ellipsis; }
  .notice { display: none; max-height: 84px; overflow: auto; margin-top: 12px; padding: 10px 12px; border: 1px solid #f0b4b8; border-radius: 10px; color: #a61b31; background: #fff0f1; font-size: 12px; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .footer { display: flex; align-items: center; justify-content: space-between; min-height: 58px; gap: 12px; padding: 13px 30px; border-top: 1px solid #d5e5f3; background: rgba(255,255,255,.96); }
  .elapsed { color: #6e87a3; font-size: 12px; }
  .elapsed:before { display: inline-block; width: 7px; height: 7px; margin: 0 8px 1px 0; border-radius: 50%; background: #2778f6; content: ""; }
  .elapsed.is-success:before { background: #13b8a6; }
  .elapsed.is-error:before { background: #e4515b; }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  button { min-height: 32px; padding: 0 13px; border: 1px solid #c9ddec; border-radius: 8px; color: #355875; background: #fff; font-family: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
  button:hover { border-color: #9fc6ea; background: #f4f9ff; }
  button.primary { border-color: #2778f6; color: #fff; background: #2778f6; box-shadow: 0 5px 12px rgba(39, 120, 246, .18); }
  button.primary:hover { border-color: #155dcc; background: #155dcc; }
  button[disabled] { cursor: default; opacity: .55; }
  @keyframes step-pulse { 0%, 100% { box-shadow: 0 0 0 3px rgba(39, 120, 246, .1); } 50% { box-shadow: 0 0 0 6px rgba(39, 120, 246, .04); } }
  @keyframes state-breathe { 0%, 100% { box-shadow: 0 0 0 5px rgba(39, 120, 246, .1); } 50% { box-shadow: 0 0 0 8px rgba(39, 120, 246, .04); } }
  @keyframes step-complete { 0% { transform: scale(.78); opacity: .45; } 65% { transform: scale(1.12); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
  @keyframes success-pop { 0% { transform: scale(.86); opacity: .6; } 70% { transform: scale(1.06); opacity: 1; } 100% { transform: scale(1); opacity: 1; } }
  @media (max-width: 680px) {
    .header { padding-left: 20px; padding-right: 20px; }
    .header-meta { margin-right: 105px; }
    .workspace { padding-left: 16px; padding-right: 16px; }
    .overview-grid { grid-template-columns: 1fr; gap: 14px; }
    .progress-panel { min-height: auto; }
    .service-panel { padding-left: 15px; padding-right: 15px; }
  }
</style>
</head>
<body>
  <main class="shell">
    <header class="header">
      <div class="header-row">
        <div class="brand"><div class="brand-mark">MN</div><div><div class="title">多媒体笔记工作台</div><div class="subtitle" id="subtitle">正在准备运行环境</div></div></div>
        <div class="header-meta">LOCAL NODE / <span id="nodeAddress">127.0.0.1</span><br />SESSION <span id="sessionState">SECURE</span></div>
        <div class="operation" id="operation">启动服务</div>
      </div>
      <div class="hero">
        <div class="state-icon busy" id="stateIcon">MN</div>
        <div class="hero-copy"><div class="eyebrow" id="eyebrow">LOCAL SERVICE CONTROL</div><div class="stage" id="stage">准备中</div><div class="detail" id="detail">正在读取本地配置并检查服务状态</div></div>
        <div class="elapsed-card"><span>已用时间</span><strong id="elapsed">0s</strong></div>
      </div>
    </header>
    <section class="workspace">
      <div class="overview-grid">
        <section class="panel status-panel">
          <div class="panel-kicker">当前状态</div>
          <div class="status-heading"><span class="status-dot" id="statusDot"></span><strong id="statusTitle">准备中</strong></div>
          <div class="status-copy" id="statusCopy">正在读取本地配置并检查服务状态</div>
          <div class="field-label">服务地址</div>
          <div class="address" id="serviceAddress">正在识别服务地址</div>
          <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
          <div class="card-progress-meta"><span>启动进度</span><strong id="progressText">0%</strong></div>
          <div class="status-panel-footer"><span class="next-step" id="cardNextStep">正在获取服务状态</span></div>
        </section>
        <aside class="panel progress-panel">
          <div class="progress-panel-title"><strong>启动进度</strong><span id="progressStep">1 / 1</span></div>
          <ol class="timeline" id="timeline"></ol>
          <div class="remaining" id="nextStep">正在获取服务状态</div>
        </aside>
      </div>
      <section class="service-section">
        <div class="section-heading"><strong>服务状态</strong><span>LIVE TELEMETRY</span></div>
        <div class="panel service-panel">
          <div class="service-row"><span>服务</span><span>状态</span><span>详情</span></div>
          <div class="service-row"><span>后端服务</span><span class="diagnostic-value" id="backendState">待检查</span><span class="diagnostic-detail" id="backendDetail">正在探测本地端口</span></div>
          <div class="service-row"><span>前端页面</span><span class="diagnostic-value" id="frontendState">待检查</span><span class="diagnostic-detail" id="frontendDetail">后端就绪后自动打开</span></div>
          <div class="service-row"><span>启动进程</span><span class="diagnostic-value" id="pidState">待检查</span><span class="diagnostic-detail" id="pidDetail">等待启动进程确认</span></div>
        </div>
      </section>
      <div class="notice" id="notice"></div>
    </section>
    <footer class="footer"><div class="elapsed" id="footerMessage">请稍候，正在执行操作</div><div class="actions"><button id="openButton" class="primary" style="display:none" onclick="openWorkbench()">打开工作台</button><button id="logButton" style="display:none" onclick="openLog()">查看日志</button><button id="retryButton" class="primary" style="display:none" onclick="retry()">重试</button><button id="closeButton" onclick="closeLauncher()">后台继续</button></div></footer>
  </main>
<script>
  var action = "";
  var shell = null;
  var fso = null;
  var root = ".";
  var config = { serverHost: "127.0.0.1", serverPort: "3000", clientHost: "127.0.0.1", clientPort: "8081", basePath: "" };
  var steps = [];
  var currentStep = -1;
  var failed = false;
  var finished = false;
  var pollTimer = null;
  var closeTimer = null;
  var startedAt = new Date().getTime();
  var startupDeadline = 300000;
  var stopDeadline = 120000;
  var pageReadyDeadline = 30000;
  var browserOpenedAt = 0;
  var initialPid = 0;
  var operationToken = "";
  var restartLaunchObserved = false;
  var browserLaunchObserved = false;
  var operationNames = { start: "启动服务", stop: "停止服务", restart: "重启服务" };
  var scriptNames = { start: "launch-windows.js", stop: "stop.js", restart: "restart-windows.js" };

  try { shell = new ActiveXObject("WScript.Shell"); } catch (e) {}
  try { fso = new ActiveXObject("Scripting.FileSystemObject"); root = fso.GetAbsolutePathName("."); } catch (e) {}
  function normalizeAction(value) {
    var normalized = String(value || "").replace(/^\s+|\s+$/g, "").toLowerCase();
    return /^(start|stop|restart)$/.test(normalized) ? normalized : "";
  }
  function resolveActionFromCommandLine(commandLine) {
    var match = String(commandLine || "").match(/(?:^|\s)["']?(start|stop|restart)["']?\s*$/i);
    return match ? normalizeAction(match[1]) : "";
  }
  function resolveActionFromLocation() {
    try { return normalizeAction(String(window.location.hash || "").replace(/^#/, "")); } catch (e) { return ""; }
  }
  function resolveLauncherAction() {
    var environmentAction = "";
    try { if (shell) environmentAction = shell.ExpandEnvironmentStrings("%WORKBENCH_LAUNCHER_ACTION%"); } catch (e) {}
    return resolveActionFromLocation() || normalizeAction(environmentAction) || resolveActionFromCommandLine(oHTA.commandLine);
  }
  try { action = resolveLauncherAction(); } catch (e) { action = ""; }

  function readEnvFile(name) {
    var values = {};
    if (!fso) return values;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, name), 1, false, 0);
      while (!file.AtEndOfStream) {
        var line = file.ReadLine().replace(/^\s+|\s+$/g, "");
        if (!line || line.charAt(0) === "#") continue;
        var index = line.indexOf("=");
        if (index < 1) continue;
        var key = line.substring(0, index).replace(/^export\s+/, "").replace(/^\s+|\s+$/g, "");
        var value = line.substring(index + 1).replace(/^\s+|\s+$/g, "").replace(/^['"]|['"]$/g, "");
        values[key] = value;
      }
      file.Close();
    } catch (e) {}
    return values;
  }

  function loadConfig() {
    var values = readEnvFile(".env");
    var local = readEnvFile(".env.local");
    var key;
    for (key in local) values[key] = local[key];
    config.serverHost = values.SERVER_HOST || config.serverHost;
    config.serverPort = values.SERVER_PORT || config.serverPort;
    config.clientHost = values.CLIENT_DEV_HOST || config.clientHost;
    config.clientPort = values.CLIENT_DEV_PORT || config.clientPort;
    config.basePath = values.CLIENT_BASE_PATH || "";
    if (config.basePath === "/") config.basePath = "";
    if (config.basePath.charAt(0) !== "/" && config.basePath) config.basePath = "/" + config.basePath;
    config.basePath = config.basePath.replace(/\/+$/, "");
    setText("nodeAddress", config.clientHost);
    setText("serviceAddress", "http://" + config.clientHost + ":" + config.clientPort + config.basePath);
  }

  function url(host, port, path) { return "http://" + host + ":" + port + (path || "/"); }
  function serverUrl() { return url(config.serverHost, config.serverPort, "/"); }
  function workbenchUrl() { return url(config.clientHost, config.clientPort, config.basePath + "/"); }
  function runtimeUrl() { return url(config.clientHost, config.clientPort, config.basePath + "/api/runtime"); }

  function httpRequest(target) {
    var request = null;
    try { request = new ActiveXObject("WinHttp.WinHttpRequest.5.1"); } catch (e) { try { request = new ActiveXObject("Microsoft.XMLHTTP"); } catch (e2) {} }
    if (!request) return { status: 0, contentType: "", body: "" };
    try { request.SetTimeouts(500, 800, 800, 1200); } catch (e) {}
    try {
      request.Open("GET", target, false);
      request.Send();
      var contentType = "";
      try { contentType = String(request.GetResponseHeader("Content-Type") || "").toLowerCase(); } catch (e) {}
      return { status: request.Status || 0, contentType: contentType, body: String(request.ResponseText || "") };
    } catch (e) { return { status: 0, contentType: "", body: "" }; }
  }

  function httpStatus(target) { return httpRequest(target).status; }
  function backendUp() { var status = httpStatus(serverUrl()); return status > 0 && status < 500; }
  function frontendReady() {
    var response = httpRequest(workbenchUrl());
    return response.status >= 200 && response.status < 400 && response.contentType.indexOf("text/html") >= 0 && /id=["']root["']/.test(response.body) && /type=["']module["']/.test(response.body);
  }
  function backendRouteReachable() {
    var status = httpStatus(runtimeUrl());
    return (status >= 200 && status < 400) || status === 401 || status === 403;
  }
  function readPid() {
    if (!fso) return 0;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\dev-local.pid"), 1, false, 0);
      var value = parseInt(file.ReadAll().replace(/^\s+|\s+$/g, ""), 10);
      file.Close();
      return isNaN(value) ? 0 : value;
    } catch (e) { return 0; }
  }
  function launcherActive() {
    var pid = readPid();
    if (!pid) return false;
    try {
      var locator = new ActiveXObject("WbemScripting.SWbemLocator");
      var service = locator.ConnectServer(".", "root\\cimv2");
      var process = service.Get("Win32_Process.Handle='" + pid + "'");
      var commandLine = String(process.CommandLine || "").toLowerCase().replace(/\\/g, "/");
      return commandLine.indexOf("scripts/dev-windows.js") >= 0;
    } catch (e) { return false; }
  }

  function setText(id, value) {
    var element = document.getElementById(id);
    if (!element) return;
    element.innerText = value;
    if (id === "stage") document.getElementById("statusTitle").innerText = value;
    if (id === "detail") document.getElementById("statusCopy").innerText = value;
  }
  function setVisualState(mode) {
    var dot = document.getElementById("statusDot");
    var progressText = document.getElementById("progressText");
    dot.className = "status-dot" + (mode === "success" ? " success" : mode === "error" ? " error" : "");
    progressText.className = mode === "success" ? "success" : mode === "error" ? "error" : "";
  }
  function setDiagnostic(id, label, good) {
    var element = document.getElementById(id);
    element.innerText = label;
    element.className = "diagnostic-value" + (good === true ? " ok" : good === false ? " bad" : "");
    var detailId = id === "backendState" ? "backendDetail" : id === "frontendState" ? "frontendDetail" : "pidDetail";
    var detail = document.getElementById(detailId);
    if (!detail) return;
    if (id === "backendState") detail.innerText = label === "已响应" ? "运行时接口已确认" : label === "未响应" ? "本地端口未响应" : label === "已停止" ? "端口已释放" : "正在探测本地端口";
    if (id === "frontendState") detail.innerText = label === "可访问" ? "页面资源已确认" : label === "未访问" ? "页面尚未启动" : label === "已停止" ? "页面已关闭" : "后端就绪后自动打开";
    if (id === "pidState") detail.innerText = label === "运行中" ? "本地进程已接管" : label === "已暂停" ? "等待重试" : label === "已释放" ? "进程树已退出" : "等待启动进程确认";
  }
  function updateDiagnostics(backend, frontend, active) { var stopping = action === "stop"; setDiagnostic("backendState", backend ? "已响应" : stopping ? "已停止" : failed ? "未响应" : "检查中", stopping ? !backend : backend ? true : failed ? false : undefined); setDiagnostic("frontendState", frontend ? "可访问" : stopping ? "已停止" : failed ? "未访问" : "等待中", stopping ? !frontend : frontend ? true : failed ? undefined : undefined); setDiagnostic("pidState", active ? "运行中" : stopping ? "已释放" : failed ? "已暂停" : "启动中", stopping ? !active : active ? true : failed ? undefined : undefined); }
  function setProgress(value) { var percent = Math.max(0, Math.min(100, value)); document.getElementById("progressBar").style.width = percent + "%"; setText("progressText", Math.round(percent) + "%"); }
  function renderSteps() {
    var html = "";
    var i;
    for (i = 0; i < steps.length; i++) {
      var cls = "step"; var icon = "";
      if (failed && i === currentStep) { cls += " error"; icon = "!"; }
      else if (i < currentStep || (finished && i === currentStep)) { cls += " done"; icon = "&#10003;"; }
      else if (i === currentStep) { cls += " active"; icon = ""; }
      else { icon = String(i + 1); }
      html += '<li class="' + cls + '"><span class="step-indicator">' + icon + '</span><span class="step-copy">' + steps[i] + '</span></li>';
    }
    document.getElementById("timeline").innerHTML = html;
    setText("progressStep", Math.min(currentStep + 1, steps.length) + " / " + steps.length);
    var next = failed ? "请处理失败后重试" : finished ? "检查完成，可以开始使用工作台" : "下一步：" + steps[Math.min(currentStep + 1, steps.length - 1)];
    setText("nextStep", next);
    setText("cardNextStep", next);
  }
  function moveTo(index, stage, detail) { currentStep = index; setText("stage", stage); setText("detail", detail); setProgress(Math.round((index / Math.max(1, steps.length - 1)) * 100)); renderSteps(); }
  function setFailure(stage, detail) {
    failed = true; detail = String(detail || ""); var summary = detail.indexOf("\n") >= 0 ? detail.substring(0, detail.indexOf("\n")) : detail; setText("stage", stage); setText("detail", summary || "启动未能完成。请查看诊断信息后重新尝试。"); setText("eyebrow", "ACTION REQUIRED"); setVisualState("error"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon error"; icon.innerText = "!"; document.getElementById("operation").className = "operation is-error"; document.getElementById("progressBar").className = "progress-bar is-error"; document.getElementById("footerMessage").className = "elapsed is-error"; document.getElementById("openButton").style.display = "none"; if (action !== "stop" && /后端|端口|启动/.test(String(stage) + detail)) { setDiagnostic("backendState", "未响应", false); setDiagnostic("frontendState", "未访问", undefined); setDiagnostic("pidState", "已暂停", undefined); } setText("footerMessage", "需要处理启动失败"); document.getElementById("notice").style.display = "block"; document.getElementById("notice").innerText = detail; document.getElementById("logButton").style.display = "inline-block"; document.getElementById("retryButton").style.display = "inline-block"; document.getElementById("closeButton").innerText = "关闭"; renderSteps();
  }
  function readLogTail() {
    if (!fso) return "";
    try { var file = fso.OpenTextFile(fso.BuildPath(root, "logs\\dev.std.log"), 1, false, 0); var text = file.ReadAll(); file.Close(); return text.length > 5000 ? text.substring(text.length - 5000) : text; } catch (e) { return ""; }
  }
  function createOperationToken() {
    if (!fso) return "";
    try {
      var token = String(new Date().getTime()) + "-" + String(Math.floor(Math.random() * 1000000));
      var file = fso.CreateTextFile(fso.BuildPath(root, "pids\\launcher-operation.token"), true, false);
      file.Write(token);
      file.Close();
      return token;
    } catch (e) { return ""; }
  }
  function restartReadyTokenMatches() {
    if (!fso || !operationToken) return false;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-ready.token"), 1, false, 0);
      var token = file.ReadAll().replace(/^\s+|\s+$/g, "");
      file.Close();
      return token === operationToken;
    } catch (e) { return false; }
  }
  function launcherUiReadyTokenMatches() {
    if (!fso || !operationToken) return false;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-ui-ready.token"), 1, false, 0);
      var token = file.ReadAll().replace(/^\s+|\s+$/g, "");
      file.Close();
      return token === operationToken;
    } catch (e) { return false; }
  }
  function readLauncherFailure() {
    if (!fso || !operationToken || !window.JSON || !window.JSON.parse) return null;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-failure.json"), 1, false, 0);
      var value = window.JSON.parse(file.ReadAll());
      file.Close();
      if (!value || value.operationToken !== operationToken) return null;
      return value;
    } catch (e) { return null; }
  }
  function formatLauncherFailure(failure) {
    var sections = [];
    if (failure.message) sections.push(String(failure.message));
    if (failure.detail) sections.push(String(failure.detail));
    if (failure.suggestion) sections.push(String(failure.suggestion));
    sections.push("可点击“查看日志”查看完整信息。");
    return sections.join("\n\n");
  }
  function openLog() { if (shell) { try { shell.Run("notepad.exe " + quote(fso.BuildPath(root, "logs\\dev.std.log")), 1, false); } catch (e) {} } }
  function quote(value) { return '"' + String(value).replace(/"/g, '""') + '"'; }
  function openWorkbench() { if (shell) { try { var separator = workbenchUrl().indexOf("?") >= 0 ? "&" : "?"; var target = workbenchUrl() + separator + "launcherReadyToken=" + encodeURIComponent(operationToken); browserOpenedAt = new Date().getTime(); shell.Run("explorer.exe " + quote(target), 1, false); } catch (e) {} } }
  function closeLauncher() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); window.close(); }
  function invokeScript() { if (!shell) { setFailure("无法执行操作", "无法创建 Windows 脚本宿主，请检查系统组件是否可用。"); return false; } try { shell.CurrentDirectory = root; shell.Run("node.exe " + quote(fso.BuildPath(root, "scripts\\" + scriptNames[action])), 0, false); return true; } catch (e) { setFailure("无法执行操作", "无法启动 Node.js。请确认 Node.js 已安装，并点击“查看日志”查看详情。\n" + e.message); return false; } }
  function complete(message, shouldOpen, keepOpen) { finished = true; currentStep = steps.length - 1; setProgress(100); var completeTitle = action === "stop" ? "服务已停止" : action === "restart" ? "重启完成" : "服务检查完成"; setText("stage", completeTitle); setText("detail", message); setText("eyebrow", "OPERATION COMPLETE"); setVisualState("success"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon success"; icon.innerText = "✓"; document.getElementById("operation").className = "operation is-success"; document.getElementById("progressBar").className = "progress-bar is-success"; document.getElementById("footerMessage").className = "elapsed is-success"; setText("footerMessage", message); renderSteps(); if (shouldOpen) { openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; } document.getElementById("closeButton").innerText = "关闭"; if (!keepOpen) { var seconds = action === "stop" ? 2 : 1; closeTimer = window.setTimeout(closeLauncher, seconds * 1000); } }
  function tickElapsed() { if (!finished && !failed) { setText("elapsed", Math.floor((new Date().getTime() - startedAt) / 1000) + "s"); window.setTimeout(tickElapsed, 1000); } }
  function poll() {
    if (finished || failed) return;
    var startupFailure = readLauncherFailure();
    if (startupFailure) { setFailure(startupFailure.stage || "启动失败", formatLauncherFailure(startupFailure)); return; }
    var now = new Date().getTime(); var elapsed = now - startedAt;
    var backend = backendUp(); var frontend = frontendReady(); var api = backendRouteReachable(); var servicesReady = restartReadyTokenMatches(); var uiReady = launcherUiReadyTokenMatches(); var pid = launcherActive(); var currentPid = readPid(); updateDiagnostics(backend && api && servicesReady, frontend && servicesReady, pid);
    if (action === "stop") {
      if (backend || frontend || pid) moveTo(1, "正在确认进程退出", "正在等待后台进程和端口完全释放");
      else complete("服务已停止，端口已释放", false);
    } else if (action === "restart") {
      if (!restartLaunchObserved && (restartReadyTokenMatches() || (initialPid > 0 && currentPid > 0 && currentPid !== initialPid))) restartLaunchObserved = true;
      if (restartLaunchObserved && currentStep < 2) moveTo(2, "旧服务已停止", "新服务已接管，正在确认后端状态");
      if (restartLaunchObserved && servicesReady && currentStep < 4) moveTo(4, "后端已就绪", "后端状态和前端入口资源已验证");
      if (restartLaunchObserved && servicesReady && !browserLaunchObserved) { browserLaunchObserved = true; moveTo(6, "正在打开工作台", "服务已验证，正在等待浏览器完成页面渲染"); openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; }
      if (restartLaunchObserved && browserLaunchObserved && uiReady) complete("重启完成，页面已完成渲染", false);
    } else {
      if (pid && currentStep < 1) moveTo(1, "服务已启动", "正在等待后端开始监听");
      if (servicesReady && currentStep < 3) moveTo(3, "后端已就绪", "后端状态和前端入口资源已验证");
      if (servicesReady && !browserLaunchObserved) { browserLaunchObserved = true; moveTo(4, "正在打开工作台", "服务已验证，正在等待浏览器完成页面渲染"); openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; }
      if (browserLaunchObserved && uiReady) complete("启动完成，页面已完成渲染", false);
    }
    if (finished || failed) return;
    if (action === "stop" && elapsed > stopDeadline) { setFailure("停止超时", "服务在 120 秒内未能完全停止。\n\n" + readLogTail()); return; }
    if (action !== "stop" && !browserLaunchObserved && elapsed > startupDeadline) { setFailure("启动超时", "服务在 300 秒内仍未完成启动。请点击“查看日志”查看当前启动阶段。\n\n" + readLogTail()); return; }
    if (action !== "stop" && browserLaunchObserved && !uiReady && browserOpenedAt > 0 && now - browserOpenedAt > pageReadyDeadline) { var readyMessage = "本地服务已经启动并验证可访问，但浏览器页面确认较慢。工作台可能已经打开；可点击“打开工作台”再次打开，不需要重复启动服务。"; complete(readyMessage, false, true); setText("eyebrow", "SERVICE READY"); document.getElementById("openButton").style.display = "inline-block"; return; }
    pollTimer = window.setTimeout(poll, 700);
  }
  function retry() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); failed = false; finished = false; startedAt = new Date().getTime(); browserOpenedAt = 0; document.getElementById("notice").style.display = "none"; document.getElementById("logButton").style.display = "none"; document.getElementById("retryButton").style.display = "none"; document.getElementById("openButton").style.display = "none"; document.getElementById("closeButton").innerText = action === "stop" ? "关闭" : "后台继续"; begin(); }
  function begin() { if (!action) { setFailure("无法识别操作", "启动器未收到有效操作参数。请从“启动多媒体笔记工作台”“停止多媒体笔记工作台”或“重启多媒体笔记工作台”命令文件启动。"); return; } loadConfig(); initialPid = readPid(); operationToken = action === "stop" ? "" : createOperationToken(); restartLaunchObserved = false; browserLaunchObserved = false; browserOpenedAt = 0; steps = action === "stop" ? ["检查运行状态", "停止服务", "确认进程退出", "确认端口释放"] : action === "restart" ? ["检查旧服务", "停止旧服务", "确认旧服务已停止", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"] : ["检查环境", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"]; currentStep = 0; setText("operation", operationNames[action]); document.getElementById("operation").className = "operation"; setText("subtitle", action === "stop" ? "正在安全停止本地服务" : action === "restart" ? "正在平滑重启本地服务" : "正在启动本地开发服务"); setText("eyebrow", "LOCAL SERVICE CONTROL"); setVisualState("busy"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon busy"; icon.innerText = "M"; document.getElementById("progressBar").className = "progress-bar"; document.getElementById("footerMessage").className = "elapsed"; setText("stage", steps[0]); setText("detail", "正在检查本地服务状态"); setText("footerMessage", "请稍候，正在执行操作"); setProgress(8); renderSteps(); if (action !== "stop" && !invokeScript()) return; if (action === "stop") invokeScript(); poll(); }
  document.getElementById("openButton").style.display = "none";
  window.resizeTo(760, 820);
  tickElapsed();
  begin();
</script>
</body>
</html>
