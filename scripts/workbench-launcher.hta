<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=Edge" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>多媒体笔记工作台</title>
<hta:application id="oHTA" applicationname="WorkbenchLauncher" border="thin" caption="yes" maximizebutton="no" minimizebutton="no" showintaskbar="yes" singleinstance="no" sysmenu="yes" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; font-family: "Segoe UI", "Microsoft YaHei", sans-serif; color: #1e293b; background: #0e172a; }
  body { display: flex; align-items: center; justify-content: center; background: #0e172a; }
  .shell { width: 720px; min-height: 570px; overflow: hidden; border: 1px solid #243653; border-radius: 20px; background: #f8fafc; box-shadow: 0 28px 80px rgba(0, 0, 0, .38); }
  .header { position: relative; overflow: hidden; padding: 24px 30px 26px; color: #fff; background: #101c33; }
  .header:before { position: absolute; top: -145px; right: -80px; width: 350px; height: 350px; border: 1px solid rgba(98, 224, 190, .18); border-radius: 50%; box-shadow: 0 0 0 46px rgba(98, 224, 190, .04), 0 0 0 92px rgba(98, 224, 190, .025); content: ""; }
  .header:after { position: absolute; right: 94px; bottom: -75px; width: 160px; height: 160px; border-radius: 50%; background: #1aa98c; filter: alpha(opacity=12); opacity: .12; content: ""; }
  .header-row, .hero { position: relative; z-index: 1; display: flex; align-items: center; }
  .header-row { justify-content: space-between; gap: 18px; }
  .brand { display: flex; align-items: center; min-width: 0; gap: 11px; }
  .brand-mark { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; flex: none; border: 1px solid rgba(179, 255, 235, .44); border-radius: 13px; color: #0a2c2c; background: #83ecd2; box-shadow: 0 8px 20px rgba(31, 183, 153, .28); font-size: 16px; font-weight: 800; letter-spacing: -.04em; }
  .title { overflow: hidden; font-size: 16px; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
  .subtitle { margin-top: 4px; color: #aabbd4; font-size: 12px; }
  .operation { display: inline-block; padding: 7px 11px; border: 1px solid rgba(181, 208, 236, .26); border-radius: 999px; color: #d6e4f6; background: rgba(255,255,255,.055); font-size: 12px; white-space: nowrap; }
  .operation:before { display: inline-block; width: 6px; height: 6px; margin: 0 7px 1px 0; border-radius: 50%; background: #70e0c5; box-shadow: 0 0 0 4px rgba(112, 224, 197, .12); content: ""; }
  .hero { margin-top: 28px; gap: 17px; }
  .state-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 72px; height: 72px; flex: none; border: 1px solid rgba(149, 239, 218, .52); border-radius: 50%; color: #0e352f; background: #83ecd2; box-shadow: 0 0 0 10px rgba(131, 236, 210, .08), 0 14px 28px rgba(0, 0, 0, .2); font-size: 15px; font-weight: 800; }
  .state-icon:before { position: absolute; width: 86px; height: 86px; border: 1px solid rgba(131, 236, 210, .24); border-radius: 50%; content: ""; }
  .state-icon.busy:after { position: absolute; width: 82px; height: 82px; border: 2px solid transparent; border-top-color: #83ecd2; border-right-color: rgba(131, 236, 210, .28); border-radius: 50%; content: ""; animation: spin 1.15s linear infinite; }
  .state-icon.busy { color: transparent; background: #1b665b; }
  .state-icon.success { color: #0a4138; background: #83ecd2; }
  .state-icon.error { border-color: #fecaca; color: #fff; background: #ca4e59; }
  .hero-copy { min-width: 0; flex: 1; }
  .eyebrow { color: #8ee1cf; font-size: 10px; font-weight: 650; letter-spacing: .13em; text-transform: uppercase; }
  .stage { margin-top: 6px; color: #fff; font-size: 24px; font-weight: 650; letter-spacing: -.02em; }
  .detail { max-width: 430px; margin-top: 6px; color: #afc0d8; font-size: 13px; line-height: 1.5; }
  .hero-meta { margin-top: 10px; color: #7c92b1; font-size: 11px; }
  .hero-meta strong { color: #cbd8e8; font-weight: 600; }
  .elapsed-card { min-width: 88px; padding: 10px 12px; border: 1px solid rgba(174, 203, 232, .17); border-radius: 12px; text-align: right; background: rgba(255,255,255,.055); }
  .elapsed-card span { display: block; color: #91a5c1; font-size: 10px; }
  .elapsed-card strong { display: block; margin-top: 3px; color: #fff; font-size: 19px; font-weight: 650; letter-spacing: -.02em; }
  .content { padding: 22px 30px 18px; }
  .progress-wrap { padding: 15px 16px 14px; border: 1px solid #e3eaf2; border-radius: 14px; background: #fff; box-shadow: 0 8px 20px rgba(15, 23, 42, .035); }
  .progress-label { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10px; color: #64748b; font-size: 12px; }
  .progress-label strong { margin-left: 7px; color: #0f766e; font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
  .progress-step { color: #94a3b8; font-size: 11px; }
  .progress-track { height: 9px; overflow: hidden; border-radius: 999px; background: #eaf0f5; }
  .progress-bar { width: 0; height: 100%; border-radius: 999px; background: #14a98a; box-shadow: 8px 0 18px rgba(20, 169, 138, .3); transition: width .35s ease; }
  .progress-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; color: #64748b; font-size: 11px; }
  .next-step { color: #64748b; }
  .next-step strong { margin-left: 4px; color: #334155; font-weight: 600; }
  .timeline-title { margin: 19px 0 9px; color: #475569; font-size: 12px; font-weight: 650; }
  .timeline { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .step { display: flex; align-items: center; width: 31.9%; min-height: 42px; gap: 8px; padding: 8px 9px; border: 1px solid #e3eaf2; border-radius: 10px; color: #94a3b8; background: #fff; font-size: 11px; }
  .step-indicator { display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; flex: none; border: 1px solid #d4dee8; border-radius: 50%; color: #94a3b8; background: #f8fafc; font-size: 10px; }
  .step-copy { min-width: 0; line-height: 1.35; }
  .step.active { border-color: #91dacb; color: #0f766e; background: #f2fcf9; box-shadow: 0 4px 11px rgba(20, 169, 138, .08); }
  .step.active .step-indicator { border-color: #14a98a; color: #fff; background: #14a98a; }
  .step.done { border-color: #d6eee9; color: #475569; }
  .step.done .step-indicator { border-color: #14a98a; color: #fff; background: #14a98a; }
  .step.error { border-color: #fecaca; color: #b4233a; background: #fff7f7; }
  .step.error .step-indicator { border-color: #d95762; color: #fff; background: #d95762; }
  .spinner { display: inline-block; width: 9px; height: 9px; border: 2px solid rgba(255,255,255,.38); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .diagnostics { display: flex; gap: 8px; margin-top: 14px; }
  .diagnostic { width: 33.333%; padding: 10px 11px; border: 1px solid #e3eaf2; border-radius: 10px; background: #fff; }
  .diagnostic-label { color: #94a3b8; font-size: 10px; }
  .diagnostic-value { margin-top: 5px; color: #64748b; font-size: 12px; font-weight: 650; }
  .diagnostic-value.ok { color: #09816c; }
  .diagnostic-value.bad { color: #c2414b; }
  .notice { display: none; margin-top: 14px; padding: 11px 12px; border: 1px solid #fecaca; border-radius: 10px; color: #a61b31; background: #fff7f7; font-size: 12px; line-height: 1.5; white-space: pre-wrap; word-break: break-word; }
  .footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 30px; border-top: 1px solid #e7edf3; background: #fff; }
  .elapsed { color: #64748b; font-size: 12px; }
  .elapsed:before { display: inline-block; width: 7px; height: 7px; margin: 0 7px 1px 0; border-radius: 50%; background: #14a98a; content: ""; }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  button { min-height: 33px; padding: 0 13px; border: 1px solid #d7e1ea; border-radius: 8px; color: #475569; background: #fff; font-family: inherit; font-size: 12px; font-weight: 600; cursor: pointer; }
  button:hover { border-color: #b9c9d8; background: #f8fafc; }
  button.primary { border-color: #10947a; color: #fff; background: #10947a; box-shadow: 0 5px 12px rgba(16, 148, 122, .16); }
  button.primary:hover { border-color: #087963; background: #087963; }
  button[disabled] { cursor: default; opacity: .55; }
</style>
</head>
<body>
  <main class="shell">
    <header class="header">
      <div class="header-row">
        <div class="brand"><div class="brand-mark">MN</div><div><div class="title">多媒体笔记工作台</div><div class="subtitle" id="subtitle">正在准备运行环境</div></div></div>
        <div class="operation" id="operation">启动服务</div>
      </div>
      <div class="hero">
        <div class="state-icon busy" id="stateIcon">MN</div>
        <div class="hero-copy"><div class="eyebrow" id="eyebrow">LOCAL SERVICE CONTROL</div><div class="stage" id="stage">准备中</div><div class="detail" id="detail">正在读取本地配置并检查服务状态</div><div class="hero-meta">本地工作区 · <strong id="serviceAddress">正在识别服务地址</strong></div></div>
        <div class="elapsed-card"><span>已用时间</span><strong id="elapsed">0s</strong></div>
      </div>
    </header>
    <section class="content">
      <div class="progress-wrap">
        <div class="progress-label"><span>启动进度 <strong id="progressText">0%</strong></span><span class="progress-step" id="progressStep">第 1 / 1 步</span></div>
        <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
        <div class="progress-meta"><span class="next-step">接下来<strong id="nextStep">正在获取服务状态</strong></span><span>可以随时切到后台继续</span></div>
      </div>
      <div class="timeline-title">启动路径</div>
      <ol class="timeline" id="timeline"></ol>
      <div class="diagnostics"><div class="diagnostic"><div class="diagnostic-label">后端服务</div><div class="diagnostic-value" id="backendState">待检查</div></div><div class="diagnostic"><div class="diagnostic-label">前端页面</div><div class="diagnostic-value" id="frontendState">待检查</div></div><div class="diagnostic"><div class="diagnostic-label">启动进程</div><div class="diagnostic-value" id="pidState">待检查</div></div></div>
      <div class="notice" id="notice"></div>
    </section>
    <footer class="footer"><div class="elapsed" id="footerMessage">请稍候，正在执行操作</div><div class="actions"><button id="openButton" class="primary" style="display:none" onclick="openWorkbench()">打开工作台</button><button id="logButton" style="display:none" onclick="openLog()">查看诊断日志</button><button id="retryButton" class="primary" style="display:none" onclick="retry()">重新尝试</button><button id="closeButton" onclick="closeLauncher()">后台继续</button></div></footer>
  </main>
<script>
  var action = "";
  var shell = null;
  var fso = null;
  var root = ".";
  var config = { serverHost: "127.0.0.1", serverPort: "3000", clientHost: "127.0.0.1", clientPort: "8081", basePath: "" };
  var steps = [];
  var currentStep = -1;
  var failed = false;
  var finished = false;
  var pollTimer = null;
  var closeTimer = null;
  var startedAt = new Date().getTime();
  var startupDeadline = 300000;
  var stopDeadline = 120000;
  var pageReadyDeadline = 30000;
  var browserOpenedAt = 0;
  var initialPid = 0;
  var operationToken = "";
  var restartLaunchObserved = false;
  var browserLaunchObserved = false;
  var operationNames = { start: "启动服务", stop: "停止服务", restart: "重启服务" };
  var scriptNames = { start: "launch-windows.js", stop: "stop.js", restart: "restart-windows.js" };

  try { shell = new ActiveXObject("WScript.Shell"); } catch (e) {}
  try { fso = new ActiveXObject("Scripting.FileSystemObject"); root = fso.GetAbsolutePathName("."); } catch (e) {}
  function normalizeAction(value) {
    var normalized = String(value || "").replace(/^\s+|\s+$/g, "").toLowerCase();
    return /^(start|stop|restart)$/.test(normalized) ? normalized : "";
  }
  function resolveActionFromCommandLine(commandLine) {
    var match = String(commandLine || "").match(/(?:^|\s)["']?(start|stop|restart)["']?\s*$/i);
    return match ? normalizeAction(match[1]) : "";
  }
  function resolveActionFromLocation() {
    try { return normalizeAction(String(window.location.hash || "").replace(/^#/, "")); } catch (e) { return ""; }
  }
  function resolveLauncherAction() {
    var environmentAction = "";
    try { if (shell) environmentAction = shell.ExpandEnvironmentStrings("%WORKBENCH_LAUNCHER_ACTION%"); } catch (e) {}
    return resolveActionFromLocation() || normalizeAction(environmentAction) || resolveActionFromCommandLine(oHTA.commandLine);
  }
  try { action = resolveLauncherAction(); } catch (e) { action = ""; }

  function readEnvFile(name) {
    var values = {};
    if (!fso) return values;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, name), 1, false, 0);
      while (!file.AtEndOfStream) {
        var line = file.ReadLine().replace(/^\s+|\s+$/g, "");
        if (!line || line.charAt(0) === "#") continue;
        var index = line.indexOf("=");
        if (index < 1) continue;
        var key = line.substring(0, index).replace(/^export\s+/, "").replace(/^\s+|\s+$/g, "");
        var value = line.substring(index + 1).replace(/^\s+|\s+$/g, "").replace(/^['"]|['"]$/g, "");
        values[key] = value;
      }
      file.Close();
    } catch (e) {}
    return values;
  }

  function loadConfig() {
    var values = readEnvFile(".env");
    var local = readEnvFile(".env.local");
    var key;
    for (key in local) values[key] = local[key];
    config.serverHost = values.SERVER_HOST || config.serverHost;
    config.serverPort = values.SERVER_PORT || config.serverPort;
    config.clientHost = values.CLIENT_DEV_HOST || config.clientHost;
    config.clientPort = values.CLIENT_DEV_PORT || config.clientPort;
    config.basePath = values.CLIENT_BASE_PATH || "";
    if (config.basePath === "/") config.basePath = "";
    if (config.basePath.charAt(0) !== "/" && config.basePath) config.basePath = "/" + config.basePath;
    config.basePath = config.basePath.replace(/\/+$/, "");
    setText("serviceAddress", "http://" + config.clientHost + ":" + config.clientPort + config.basePath);
  }

  function url(host, port, path) { return "http://" + host + ":" + port + (path || "/"); }
  function serverUrl() { return url(config.serverHost, config.serverPort, "/"); }
  function workbenchUrl() { return url(config.clientHost, config.clientPort, config.basePath + "/"); }
  function runtimeUrl() { return url(config.clientHost, config.clientPort, config.basePath + "/api/runtime"); }

  function httpRequest(target) {
    var request = null;
    try { request = new ActiveXObject("WinHttp.WinHttpRequest.5.1"); } catch (e) { try { request = new ActiveXObject("Microsoft.XMLHTTP"); } catch (e2) {} }
    if (!request) return { status: 0, contentType: "", body: "" };
    try { request.SetTimeouts(500, 800, 800, 1200); } catch (e) {}
    try {
      request.Open("GET", target, false);
      request.Send();
      var contentType = "";
      try { contentType = String(request.GetResponseHeader("Content-Type") || "").toLowerCase(); } catch (e) {}
      return { status: request.Status || 0, contentType: contentType, body: String(request.ResponseText || "") };
    } catch (e) { return { status: 0, contentType: "", body: "" }; }
  }

  function httpStatus(target) { return httpRequest(target).status; }
  function backendUp() { var status = httpStatus(serverUrl()); return status > 0 && status < 500; }
  function frontendReady() {
    var response = httpRequest(workbenchUrl());
    return response.status >= 200 && response.status < 400 && response.contentType.indexOf("text/html") >= 0 && /id=["']root["']/.test(response.body) && /type=["']module["']/.test(response.body);
  }
  function backendRouteReachable() {
    var status = httpStatus(runtimeUrl());
    return (status >= 200 && status < 400) || status === 401 || status === 403;
  }
  function readPid() {
    if (!fso) return 0;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\dev-local.pid"), 1, false, 0);
      var value = parseInt(file.ReadAll().replace(/^\s+|\s+$/g, ""), 10);
      file.Close();
      return isNaN(value) ? 0 : value;
    } catch (e) { return 0; }
  }
  function launcherActive() {
    var pid = readPid();
    if (!pid) return false;
    try {
      var locator = new ActiveXObject("WbemScripting.SWbemLocator");
      var service = locator.ConnectServer(".", "root\\cimv2");
      var process = service.Get("Win32_Process.Handle='" + pid + "'");
      var commandLine = String(process.CommandLine || "").toLowerCase().replace(/\\/g, "/");
      return commandLine.indexOf("scripts/dev-windows.js") >= 0;
    } catch (e) { return false; }
  }

  function setText(id, value) { document.getElementById(id).innerText = value; }
  function setDiagnostic(id, label, good) { var element = document.getElementById(id); element.innerText = label; element.className = "diagnostic-value" + (good === true ? " ok" : good === false ? " bad" : ""); }
  function updateDiagnostics(backend, frontend, active) { var stopping = action === "stop"; setDiagnostic("backendState", backend ? "已响应" : stopping ? "已停止" : "未响应", stopping ? !backend : backend); setDiagnostic("frontendState", frontend ? "可访问" : stopping ? "已停止" : "未访问", stopping ? !frontend : frontend); setDiagnostic("pidState", active ? "运行中" : "已释放", stopping ? !active : active); }
  function setProgress(value) { var percent = Math.max(0, Math.min(100, value)); document.getElementById("progressBar").style.width = percent + "%"; setText("progressText", Math.round(percent) + "%"); }
  function renderSteps() {
    var html = "";
    var i;
    for (i = 0; i < steps.length; i++) {
      var cls = "step"; var icon = "";
      if (failed && i === currentStep) { cls += " error"; icon = "!"; }
      else if (i < currentStep || (finished && i === currentStep)) { cls += " done"; icon = "&#10003;"; }
      else if (i === currentStep) { cls += " active"; icon = '<span class="spinner"></span>'; }
      else { icon = String(i + 1); }
      html += '<li class="' + cls + '"><span class="step-indicator">' + icon + '</span><span class="step-copy">' + steps[i] + '</span></li>';
    }
    document.getElementById("timeline").innerHTML = html;
    setText("progressStep", "第 " + Math.min(currentStep + 1, steps.length) + " / " + steps.length + " 步");
    setText("nextStep", failed ? "查看诊断信息后重新尝试" : finished ? "已可以开始使用工作台" : steps[Math.min(currentStep + 1, steps.length - 1)]);
  }
  function moveTo(index, stage, detail) { currentStep = index; setText("stage", stage); setText("detail", detail); setProgress(Math.round((index / Math.max(1, steps.length - 1)) * 100)); renderSteps(); }
  function setFailure(stage, detail) {
    failed = true; var summary = detail.indexOf("\n") >= 0 ? detail.substring(0, detail.indexOf("\n")) : detail; setText("stage", stage); setText("detail", summary || "启动未能完成。请查看诊断信息后重新尝试。"); setText("eyebrow", "ACTION REQUIRED"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon error"; icon.innerText = "!"; setText("footerMessage", "需要你的处理：服务尚未就绪"); document.getElementById("notice").style.display = "block"; document.getElementById("notice").innerText = detail; document.getElementById("logButton").style.display = "inline-block"; document.getElementById("retryButton").style.display = "inline-block"; document.getElementById("closeButton").innerText = "关闭"; renderSteps();
  }
  function readLogTail() {
    if (!fso) return "";
    try { var file = fso.OpenTextFile(fso.BuildPath(root, "logs\\dev.std.log"), 1, false, 0); var text = file.ReadAll(); file.Close(); return text.length > 5000 ? text.substring(text.length - 5000) : text; } catch (e) { return ""; }
  }
  function createOperationToken() {
    if (!fso) return "";
    try {
      var token = String(new Date().getTime()) + "-" + String(Math.floor(Math.random() * 1000000));
      var file = fso.CreateTextFile(fso.BuildPath(root, "pids\\launcher-operation.token"), true, false);
      file.Write(token);
      file.Close();
      return token;
    } catch (e) { return ""; }
  }
  function restartReadyTokenMatches() {
    if (!fso || !operationToken) return false;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-ready.token"), 1, false, 0);
      var token = file.ReadAll().replace(/^\s+|\s+$/g, "");
      file.Close();
      return token === operationToken;
    } catch (e) { return false; }
  }
  function launcherUiReadyTokenMatches() {
    if (!fso || !operationToken) return false;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-ui-ready.token"), 1, false, 0);
      var token = file.ReadAll().replace(/^\s+|\s+$/g, "");
      file.Close();
      return token === operationToken;
    } catch (e) { return false; }
  }
  function readLauncherFailure() {
    if (!fso || !operationToken || !window.JSON || !window.JSON.parse) return null;
    try {
      var file = fso.OpenTextFile(fso.BuildPath(root, "pids\\launcher-failure.json"), 1, false, 0);
      var value = window.JSON.parse(file.ReadAll());
      file.Close();
      if (!value || value.operationToken !== operationToken) return null;
      return value;
    } catch (e) { return null; }
  }
  function formatLauncherFailure(failure) {
    var sections = [];
    if (failure.message) sections.push(String(failure.message));
    if (failure.detail) sections.push(String(failure.detail));
    if (failure.suggestion) sections.push(String(failure.suggestion));
    sections.push("可点击“打开日志”查看完整信息。");
    return sections.join("\n\n");
  }
  function openLog() { if (shell) { try { shell.Run("notepad.exe " + quote(fso.BuildPath(root, "logs\\dev.std.log")), 1, false); } catch (e) {} } }
  function quote(value) { return '"' + String(value).replace(/"/g, '""') + '"'; }
  function openWorkbench() { if (shell) { try { var separator = workbenchUrl().indexOf("?") >= 0 ? "&" : "?"; var target = workbenchUrl() + separator + "launcherReadyToken=" + encodeURIComponent(operationToken); browserOpenedAt = new Date().getTime(); shell.Run("explorer.exe " + quote(target), 1, false); } catch (e) {} } }
  function closeLauncher() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); window.close(); }
  function invokeScript() { if (!shell) { setFailure("无法执行操作", "无法创建 Windows 脚本宿主，请检查系统组件是否可用。"); return false; } try { shell.CurrentDirectory = root; shell.Run("node.exe " + quote(fso.BuildPath(root, "scripts\\" + scriptNames[action])), 0, false); return true; } catch (e) { setFailure("无法执行操作", "无法启动 Node.js。请确认 Node.js 已安装，并点击“打开日志”查看详情。\n" + e.message); return false; } }
  function complete(message, shouldOpen, keepOpen) { finished = true; currentStep = steps.length - 1; setProgress(100); setText("stage", "已完成"); setText("detail", message); setText("eyebrow", "OPERATION COMPLETE"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon success"; icon.innerText = "OK"; setText("footerMessage", message); renderSteps(); if (shouldOpen) { openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; } document.getElementById("closeButton").innerText = "关闭"; if (!keepOpen) { var seconds = action === "stop" ? 2 : 1; closeTimer = window.setTimeout(closeLauncher, seconds * 1000); } }
  function tickElapsed() { if (!finished && !failed) { setText("elapsed", Math.floor((new Date().getTime() - startedAt) / 1000) + "s"); window.setTimeout(tickElapsed, 1000); } }
  function poll() {
    if (finished || failed) return;
    var startupFailure = readLauncherFailure();
    if (startupFailure) { setFailure(startupFailure.stage || "启动失败", formatLauncherFailure(startupFailure)); return; }
    var now = new Date().getTime(); var elapsed = now - startedAt;
    var backend = backendUp(); var frontend = frontendReady(); var api = backendRouteReachable(); var servicesReady = restartReadyTokenMatches(); var uiReady = launcherUiReadyTokenMatches(); var pid = launcherActive(); var currentPid = readPid(); updateDiagnostics(backend && api && servicesReady, frontend && servicesReady, pid);
    if (action === "stop") {
      if (backend || frontend || pid) moveTo(1, "正在确认进程退出", "正在等待后台进程和端口完全释放");
      else complete("服务已停止，端口已释放", false);
    } else if (action === "restart") {
      if (!restartLaunchObserved && (restartReadyTokenMatches() || (initialPid > 0 && currentPid > 0 && currentPid !== initialPid))) restartLaunchObserved = true;
      if (restartLaunchObserved && currentStep < 2) moveTo(2, "旧服务已停止", "新服务已接管，正在确认后端状态");
      if (restartLaunchObserved && servicesReady && currentStep < 4) moveTo(4, "后端已就绪", "后端状态和前端入口资源已验证");
      if (restartLaunchObserved && servicesReady && !browserLaunchObserved) { browserLaunchObserved = true; moveTo(6, "正在打开工作台", "服务已验证，正在等待浏览器完成页面渲染"); openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; }
      if (restartLaunchObserved && browserLaunchObserved && uiReady) complete("重启完成，页面已完成渲染", false);
    } else {
      if (pid && currentStep < 1) moveTo(1, "服务已启动", "正在等待后端开始监听");
      if (servicesReady && currentStep < 3) moveTo(3, "后端已就绪", "后端状态和前端入口资源已验证");
      if (servicesReady && !browserLaunchObserved) { browserLaunchObserved = true; moveTo(4, "正在打开工作台", "服务已验证，正在等待浏览器完成页面渲染"); openWorkbench(); document.getElementById("openButton").style.display = "inline-block"; }
      if (browserLaunchObserved && uiReady) complete("启动完成，页面已完成渲染", false);
    }
    if (finished || failed) return;
    if (action === "stop" && elapsed > stopDeadline) { setFailure("停止超时", "服务在 120 秒内未能完全停止。\n\n" + readLogTail()); return; }
    if (action !== "stop" && !browserLaunchObserved && elapsed > startupDeadline) { setFailure("启动超时", "服务在 300 秒内仍未完成启动。请点击“打开日志”查看当前启动阶段。\n\n" + readLogTail()); return; }
    if (action !== "stop" && browserLaunchObserved && !uiReady && browserOpenedAt > 0 && now - browserOpenedAt > pageReadyDeadline) { var readyMessage = "本地服务已经启动并验证可访问，但浏览器页面确认较慢。工作台可能已经打开；可点击“打开工作台”再次打开，不需要重复启动服务。"; complete(readyMessage, false, true); setText("eyebrow", "SERVICE READY"); document.getElementById("openButton").style.display = "inline-block"; return; }
    pollTimer = window.setTimeout(poll, 700);
  }
  function retry() { if (pollTimer) window.clearTimeout(pollTimer); if (closeTimer) window.clearTimeout(closeTimer); failed = false; finished = false; startedAt = new Date().getTime(); browserOpenedAt = 0; document.getElementById("notice").style.display = "none"; document.getElementById("logButton").style.display = "none"; document.getElementById("retryButton").style.display = "none"; document.getElementById("openButton").style.display = "none"; document.getElementById("closeButton").innerText = action === "stop" ? "关闭" : "后台继续"; begin(); }
  function begin() { if (!action) { setFailure("无法识别操作", "启动器未收到有效操作参数。请从“启动多媒体笔记工作台”“停止多媒体笔记工作台”或“重启多媒体笔记工作台”命令文件启动。"); return; } loadConfig(); initialPid = readPid(); operationToken = action === "stop" ? "" : createOperationToken(); restartLaunchObserved = false; browserLaunchObserved = false; browserOpenedAt = 0; steps = action === "stop" ? ["检查运行状态", "停止服务", "确认进程退出", "确认端口释放"] : action === "restart" ? ["检查旧服务", "停止旧服务", "确认旧服务已停止", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"] : ["检查环境", "启动后端", "确认后端就绪", "启动前端", "确认页面可访问", "打开工作台"]; currentStep = 0; setText("operation", operationNames[action]); setText("subtitle", action === "stop" ? "正在安全停止本地服务" : action === "restart" ? "正在平滑重启本地服务" : "正在启动本地开发服务"); setText("eyebrow", "LOCAL SERVICE CONTROL"); var icon = document.getElementById("stateIcon"); icon.className = "state-icon busy"; icon.innerText = "M"; setText("stage", steps[0]); setText("detail", "正在检查本地服务状态"); setText("footerMessage", "请稍候，正在执行操作"); setProgress(8); renderSteps(); if (action !== "stop" && !invokeScript()) return; if (action === "stop") invokeScript(); poll(); }
  document.getElementById("openButton").style.display = "none";
  window.resizeTo(760, 820);
  tickElapsed();
  begin();
</script>
</body>
</html>
